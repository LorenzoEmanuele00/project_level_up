    {
      "name": "heroes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"heroes\" (\"id\" TEXT NOT NULL, \"user_id\" TEXT NULL, \"name\" TEXT NULL, \"avatar_mode\" TEXT NOT NULL, \"avatar_icon\" TEXT NULL, \"accent\" TEXT NOT NULL, \"hero_class\" TEXT NULL, \"level\" INTEGER NOT NULL CHECK(\"level\" >= 1), \"exp\" INTEGER NOT NULL CHECK(\"exp\" >= 0), \"reward_points\" INTEGER NOT NULL CHECK(\"reward_points\" >= 0), \"theme\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "habits",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"habits\" (\"id\" TEXT NOT NULL, \"hero_id\" TEXT NOT NULL REFERENCES heroes (id) ON DELETE RESTRICT, \"name\" TEXT NOT NULL, \"icon\" TEXT NOT NULL, \"difficulty\" TEXT NOT NULL, \"frequency\" TEXT NOT NULL, \"hue\" TEXT NOT NULL, \"streak\" INTEGER NOT NULL CHECK(\"streak\" >= 0), \"best_streak\" INTEGER NOT NULL CHECK(\"best_streak\" >= \"streak\"), \"total_completions\" INTEGER NOT NULL CHECK(\"total_completions\" >= 0), \"archived\" INTEGER NOT NULL CHECK (\"archived\" IN (0, 1)), \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "rewards",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"rewards\" (\"id\" TEXT NOT NULL, \"hero_id\" TEXT NOT NULL REFERENCES heroes (id) ON DELETE RESTRICT, \"name\" TEXT NOT NULL, \"note\" TEXT NULL, \"tier\" TEXT NOT NULL, \"redeemed_at\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "redemptions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"redemptions\" (\"id\" TEXT NOT NULL, \"hero_id\" TEXT NOT NULL REFERENCES heroes (id) ON DELETE RESTRICT, \"reward_name\" TEXT NOT NULL, \"cost\" INTEGER NOT NULL CHECK(\"cost\" >= 0), \"level_at\" INTEGER NOT NULL CHECK(\"level_at\" >= 1), \"at\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "completions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"completions\" (\"id\" TEXT NOT NULL, \"habit_id\" TEXT NOT NULL REFERENCES habits (id) ON DELETE RESTRICT, \"at\" INTEGER NOT NULL, \"exp\" INTEGER NOT NULL CHECK(\"exp\" >= 0), \"frequency\" TEXT NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
